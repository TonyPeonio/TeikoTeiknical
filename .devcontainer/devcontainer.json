{
  // GitHub Codespaces reads this file to decide which container to start.
  // Python 3.12: the pinned packages in requirements.txt (e.g. scipy 1.18) need >= 3.12.
  "name": "Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  // Nothing is installed or started automatically: run `make setup`,
  // `make pipeline` and `make dashboard` yourself (that's what the graders do).
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Dashboard",
      "onAutoForward": "openBrowser"
    }
  }
}
